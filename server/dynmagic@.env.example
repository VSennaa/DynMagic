# Per-instance settings for dynmagic@<instance>.service.
# Copy to /etc/dynmagic/<instance>.env and edit. Ports 7777/7779/7780 leave
# UDP 7778 free for LAN discovery (which is per-machine, not per-instance).

# dynmagic@room1.env
DYNMAGIC_PORT=7777
DYNMAGIC_NAME=Arena 1
# D3: overtime default is Colapso; use "random" for the alpha rotation.
DYNMAGIC_EXTRA=--overtime collapse --arena rotation
