[Unit]
Description=DynMagic dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dynmagic
WorkingDirectory=/opt/dynmagic
ExecStart=/opt/dynmagic/DynMagic-server.x86_64 --headless -- --server --name "DynMagic" --port 7777
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=dynmagic
Environment=XDG_DATA_HOME=/var/lib/dynmagic

[Install]
WantedBy=multi-user.target
